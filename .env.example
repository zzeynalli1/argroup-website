# Copy this file to .env and fill in real values. .env is git-ignored and
# must never be committed.
#
# Supabase (CMS backend foundation — see supabase/README.md). Both values
# below are the public "publishable" key pair: safe to expose in client-side
# code because every table/bucket they can reach is restricted by Row Level
# Security policies (see supabase/migrations/). The Supabase "service_role"
# key (and the legacy "secret" key) is a SEPARATE, secret key that must
# NEVER be set here, used in frontend code, or committed anywhere in this
# repo.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Example (uncomment/add when a real backend/API is wired up):
# VITE_CONTACT_API_URL=
